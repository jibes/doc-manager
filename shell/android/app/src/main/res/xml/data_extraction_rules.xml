<?xml version="1.0" encoding="utf-8"?>
<!-- As backup_rules.xml: WebView storage (settings with the AI key) neither goes to the cloud nor to a new device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="outgoing/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview/" />
        <exclude domain="file" path="outgoing/" />
    </device-transfer>
</data-extraction-rules>
