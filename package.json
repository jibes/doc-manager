  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "engine": "node scripts/build-engine.mjs --minify",
    "postinstall": "node scripts/build-engine.mjs --minify",
    "build:web": "npm run engine && expo export -p web && node scripts/postexport.mjs",
    "sample": "python3 scripts/make-sample-pdf.py assets/samples/welcome-to-tessel.pdf",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:e2e": "node e2e/smoke.mjs",
    "test": "vitest run",
    "build:desktop-web": "npm run engine && expo export -p web --output-dir shell/desktop/www && OUT_DIR=shell/desktop/www node scripts/postexport.mjs",
    "build:android-web": "npm run engine && expo export -p web --output-dir shell/android/app/src/main/assets/www && OUT_DIR=shell/android/app/src/main/assets/www node scripts/postexport.mjs",
    "test:scan": "node e2e/scan/run.mjs"
